# ==========================================================
# FlowKit Multi-Machine Environment Configuration
# Copy this file to .env and adjust paths for your local machine.
# .env is ignored by Git, ensuring local configs do not conflict.
# ==========================================================

# 1. Base Repository Root (Leave blank to auto-detect current repository path)
# REPO_DIR=/Users/your_username/Documents/GitHub/chrome-automation-web-template

# 2. Channel Knowledge Vault Base Directory (Google Drive)
# LAKORN_CHANNEL_DIR=/Users/your_username/Library/CloudStorage/GoogleDrive-user@gmail.com/My Drive/Knowledge Vault/Project/AI shorts/Channels/2 - ผักกาดการละคร - ละครไทย

# 3. Shopee Drama Project Directory
# SHOPEE_PROJECT_DIR=/Users/your_username/Library/CloudStorage/GoogleDrive-user@gmail.com/My Drive/Knowledge Vault/Project/AI shorts/Channels/9 - ป้ายยาที่ตาซ้าย/0 - รอสร้างวิดีโอ/V1 - ดราม่าขายของ

# 4. CapCut macOS Drafts & Cache Directory
# CAPCUT_DRAFTS_ROOT=/Users/your_username/Movies/CapCut/User Data/Projects/com.lveditor.draft

# 5. Whisper Model Cache Directory / Path
# WHISPER_MODEL_PATH=/Users/your_username/.cache/whisper/ggml-base.bin

# 6. Network Ports & Hosts
API_HOST=127.0.0.1
API_PORT=6969
WS_HOST=127.0.0.1
WS_PORT=9225
STATUS_PORT=8181
FLOW_AGENT_PORT=8100
